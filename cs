.tabs-row {
  display: flex;
  gap: 8px;
  margin: 10px 0 12px 0;
}

.epsal-tab {
  min-width: 130px;
  height: 32px;
  border: 1px solid #aac0b7;
  background: #fff;
  color: #5f666d;
  font-size: 12px;
  cursor: pointer;
}

.epsal-tab.active {
  background: #7ea796;
  color: #fff;
}

.section-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.detail-view-field {
  width: 160px;
}
