.tabs-row {
  display: flex;
  gap: 8px;
  margin: 10px 0 12px 0;
}

.epsal-tab {
  min-width: 130px;
  height: 32px;
  border: 1px solid #aac0b7;
  background: #fff;
  color: #5f666d;
  font-size: 12px;
  cursor: pointer;
}

.epsal-tab.active {
  background: #7ea796;
  color: #fff;
}

.section-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.detail-view-field {
  width: 160px;
}


.toolbar-spacer {
  flex: 1;
}

.search-section {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.search-form-field {
  width: 230px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.section-left {
  display: flex;
  flex-direction: column;
}

.section-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.tabs-row {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}

.epsal-tab {
  min-width: 110px;
  height: 30px;
  border: 1px solid #aabeb4;
  background: #fff;
  color: #666;
  font-size: 11px;
  cursor: pointer;
}

.epsal-tab.active {
  background: #7ea796;
  color: #fff;
}

.detail-view-field {
  width: 150px;
}

.export-btn {
  height: 34px;
  min-width: 90px;
  border: 1px solid #b8bcc8;
  border-radius: 18px;
  background: #fff;
  color: #6e78b4;
  font-size: 12px;
}

