:host {
  display: block;
}

.aggregated-book-account-dialog {
  width: min(1540px, 96vw);
  min-width: 1000px;
  background: var(--white, #ffffff);
  color: var(--gray-900, #212121);
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 50px;
  padding: 0 18px;
  border-bottom: 1px solid var(--gray-400, #bdbdbd);
}

.dialog-title {
  color: var(--title-color, #00965e);
  font-size: 13px;
  font-weight: 600;
}

.dialog-close-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: var(--gray-800, #424242);
  cursor: pointer;

  &:hover {
    background: var(--gray-100, #f5f5f5);
  }
}

.dialog-scroll-content {
  max-height: calc(90vh - 50px);
  overflow-y: auto;
  padding: 18px;
}

.summary-grid {
  display: grid;
  grid-template-columns: 0.7fr 1.5fr 0.9fr 0.85fr 1.4fr 0.65fr;
  overflow: hidden;
  border-top: 1px solid var(--gray-400, #bdbdbd);
  border-left: 1px solid var(--gray-400, #bdbdbd);
  border-radius: 2px;
}

.summary-cell {
  display: flex;
  min-height: 72px;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
  padding: 8px 12px;
  border-right: 1px solid var(--gray-400, #bdbdbd);
  border-bottom: 1px solid var(--gray-400, #bdbdbd);
}

.summary-label {
  color: var(--gray-700, #616161);
  font-size: 11px;
  font-weight: 600;
}

.summary-value {
  color: var(--gray-900, #212121);
  font-size: 12px;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.grids-container {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  gap: 36px;
  margin-top: 24px;
  align-items: start;
}

.grid-section {
  height: 560px;
  min-width: 0;
}

.epsal-popup-grid {
  display: block;
  width: 100%;
  height: 100%;

  --ag-font-size: 11px;
  --ag-font-family: var(
    --font-family-primary,
    'Roboto',
    'Helvetica Neue',
    sans-serif
  );
  --ag-header-height: 46px;
  --ag-row-height: 38px;
  --ag-border-color: var(--gray-400, #bdbdbd);
  --ag-header-background-color: #d9ebe6;
  --ag-header-foreground-color: var(--gray-800, #424242);
  --ag-odd-row-background-color: #e7f1ee;
  --ag-background-color: #ffffff;
  --ag-row-border-color: var(--gray-300, #e0e0e0);
  --ag-selected-row-background-color: #d7ece6;
}

:host ::ng-deep .epsal-popup-grid .ag-header-cell-label {
  white-space: normal;
  line-height: 14px;
  font-weight: 600;
}

:host ::ng-deep .epsal-popup-grid .ag-cell {
  display: flex;
  align-items: center;
}

:host ::ng-deep .epsal-popup-grid .epsal-negative-value {
  color: var(--error, #f44336);
  font-weight: 600;
}

:host ::ng-deep .epsal-popup-grid .epsal-positive-value {
  color: var(--gray-900, #212121);
}





.aggregated-book-account-info {
  width: 100%;
  margin-bottom: 26px;
  overflow-x: auto;
}

.aggregated-book-account-info__table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  font-size: 11px;
  color: var(--gray-900, #212121);
}

.aggregated-book-account-info__table th,
.aggregated-book-account-info__table td {
  height: 42px;
  padding: 0 12px;
  border: 1px solid #bdbdbd;
  vertical-align: middle;
}

.aggregated-book-account-info__table th {
  width: 12%;
  background-color: #e1eeeb;
  color: var(--title-color, #00965e);
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

.aggregated-book-account-info__table td {
  width: 21.33%;
  background-color: #ffffff;
  color: #424242;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
