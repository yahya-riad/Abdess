<div class="px-4 pt-4">
  <div class="flex items-center bg-[#5f6f7b] px-4 py-3">
    <div class="flex items-center gap-2">
      <mat-form-field appearance="outline" class="w-[180px]">
        <input
          matInput
          [matDatepicker]="lastImportPicker"
          [(ngModel)]="lastImport"
          placeholder="Last Import" />
        <mat-datepicker-toggle matIconSuffix [for]="lastImportPicker"></mat-datepicker-toggle>
        <mat-datepicker #lastImportPicker></mat-datepicker>
      </mat-form-field>

      <button
        mat-stroked-button
        class="!h-[30px] !min-w-[38px] !rounded-sm !border-[#89a59e] !bg-[#7ea796] !px-2 !text-[10px] !font-medium !text-white">
        OK
      </button>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <mat-form-field appearance="outline" class="w-[180px]">
        <input
          matInput
          [(ngModel)]="searchText"
          placeholder="Search"
          (input)="applySearch()" />
        <mat-icon matIconSuffix>search</mat-icon>
      </mat-form-field>

      <button
        mat-stroked-button
        class="!h-[30px] !min-w-[38px] !rounded-sm !border-[#89a59e] !bg-[#7ea796] !px-2 !text-[10px] !font-medium !text-white">
        OK
      </button>
    </div>
  </div>

  <div class="mt-4 text-[12px] text-[#7ea796]">Epsal Synthesis</div>

  <div class="mt-2 flex items-start justify-between gap-4">
    <div class="flex items-center gap-2">
      <button
        class="h-[28px] min-w-[92px] border border-[#b8c5bd] px-3 text-[10px] text-[#5f6662]"
        [ngClass]="activeTab === 0 ? 'bg-[#87b29f] text-white border-[#87b29f]' : 'bg-white'"
        (click)="activeTab = 0">
        Synthesis
      </button>

      <button
        class="h-[28px] min-w-[92px] border border-[#b8c5bd] bg-white px-3 text-[10px] text-[#5f6662]"
        (click)="activeTab = 1">
        Firm Orders
      </button>

      <button
        class="h-[28px] min-w-[92px] border border-[#b8c5bd] bg-white px-3 text-[10px] text-[#5f6662]"
        (click)="activeTab = 2">
        Limit Orders
      </button>

      <button
        class="h-[28px] min-w-[92px] border border-[#b8c5bd] bg-white px-3 text-[10px] text-[#5f6662]"
        (click)="activeTab = 3">
        Arbitrage Orders
      </button>
    </div>

    <div class="flex items-start gap-2">
      <mat-form-field appearance="outline" class="w-[132px]">
        <mat-label>Detailed View</mat-label>
        <mat-select [(value)]="detailView">
          <mat-option *ngFor="let option of detailViewOptions" [value]="option.value">
            {{ option.label }}
          </mat-option>
        </mat-select>
      </mat-form-field>

      <button
        mat-stroked-button
        class="!mt-[2px] !h-[28px] !min-w-[74px] !rounded-sm !border-[#b7c4bb] !bg-white !px-2.5 !text-[10px] !font-medium !text-[#7c8a80] !shadow-none">
        Export XLS
      </button>
    </div>
  </div>

  <div class="mt-3 bg-white">
    <div class="h-[330px] w-full">
      <ag-grid-angular
        class="h-full w-full"
        [columnDefs]="columnDefs"
        [defaultColDef]="defaultColDef"
        [rowData]="rowData"
        [rowModelType]="rowModelType"
        [pagination]="true"
        [paginationPageSize]="20"
        [theme]="theme"
        (gridReady)="onGridReady($event)">
      </ag-grid-angular>
    </div>
  </div>
</div>
