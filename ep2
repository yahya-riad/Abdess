<div class="filters-section flex items-center mb-5 bg-[#5A6978] p-3">
  <div class="date-pickers-section flex items-center stretch">
    <mat-form-field class="date-form-field">
      <input
        matInput
        [matDatepicker]="lastImportPicker"
        [(ngModel)]="lastImport"
        placeholder="Last Import"
      />
      <mat-datepicker-toggle matIconSuffix [for]="lastImportPicker"></mat-datepicker-toggle>
      <mat-datepicker #lastImportPicker></mat-datepicker>
    </mat-form-field>

    <button matButton="outlined" class="bg-[#64a1b0] ml-2 text-white!" (click)="refreshGrid()">
      OK
    </button>
  </div>

  <div class="spacer"></div>

  <div class="search-section flex items-center">
    <mat-form-field class="search-form-field">
      <input
        matInput
        [(ngModel)]="searchText"
        placeholder="Search"
        (input)="applySearch()"
      />
      <mat-icon matIconSuffix>search</mat-icon>
    </mat-form-field>

    <button matButton="outlined" class="bg-[#64a1b0] ml-2 text-white!" (click)="applySearch()">
      OK
    </button>
  </div>
</div>

<div class="page-content">
  <mat-label class="section-label">Epsal Synthesis</mat-label>

  <div class="tabs-row">
    <button class="epsal-tab" [class.active]="activeTab === 0" (click)="setTab(0)">Synthesis</button>
    <button class="epsal-tab" [class.active]="activeTab === 1" (click)="setTab(1)">Firm Orders</button>
    <button class="epsal-tab" [class.active]="activeTab === 2" (click)="setTab(2)">Limit Orders</button>
    <button class="epsal-tab" [class.active]="activeTab === 3" (click)="setTab(3)">Arbitrage Orders</button>
  </div>

  <div class="actions-row flex justify-end mb-2">
    <mat-form-field class="detail-view-field">
      <mat-label>Detailed View</mat-label>
      <mat-select [(value)]="detailView">
        <mat-option *ngFor="let option of detailViewOptions" [value]="option.value">
          {{ option.label }}
        </mat-option>
      </mat-select>
    </mat-form-field>

    <button matButton="outlined" class="bg-[#f6f7f8] ml-2 export-btn" (click)="exportXls()">
      Export XLS
    </button>
  </div>

  <div class="bg-white p-2">
    <div class="grid-container">
      <ag-grid-angular
        style="width: 100%; height: 100%;"
        [columnDefs]="columnDefs"
        [defaultColDef]="defaultColDef"
        [rowModelType]="rowModelType"
        [pagination]="true"
        [paginationPageSize]="20"
        [rowData]="rowData"
        [theme]="theme"
        [suppressMultiSort]="true"
        (gridReady)="onGridReady($event)">
      </ag-grid-angular>
    </div>
  </div>
</div>
